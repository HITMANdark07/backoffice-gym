{
  "name": "shopgym",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "db:generate": "pnpm --filter @shopgym/db generate",
    "db:migrate:test": "pnpm --filter @shopgym/db migrate:test",
    "test": "pnpm db:generate && pnpm db:migrate:test && vitest run",
    "typecheck": "pnpm db:generate && pnpm -r typecheck",
    "api": "pnpm --filter @shopgym/api start",
    "replay": "pnpm --filter @shopgym/replay start"
  },
  "devDependencies": {
    "@shopgym/db": "workspace:*",
    "@types/node": "^20.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
